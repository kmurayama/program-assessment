# RStudio project metadata and local R session state.
# These files are machine- or user-specific and should not be shared.
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Local environment variables, including paths to confidential source data.
# Commit .Renviron.example instead; never commit the populated .Renviron file.
.Renviron

# Regenerable pipeline outputs.
# Retain the empty directory in Git so scripts have a documented destination.
outputs/*
!outputs/.gitkeep

# Rendered office and HTML documents.
# Reusable source templates are exceptions; generated deliverables stay local.
*docx
!template*.docx
*html
*pptx
!my-style*.pptx

# Outputs and supporting assets generated when rendering R Markdown files.
# Keep the legacy `out` rule because archived notebooks still use that name.
**/outputs/**
**/out/**
**/*_cache/**
**/*_files/**
**/libs/**
