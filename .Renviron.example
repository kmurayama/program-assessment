# Copy this file to .Renviron (which is gitignored) and adjust as needed.
#
# To run the pipeline against the committed synthetic data (no access to
# real student data required):
ACBSP_DATA_PATH="data/synthetic"

# To run against the real data instead (requires access), point this at
# the real data root, e.g.:
# ACBSP_DATA_PATH="C:\Users\you\path\to\Data"
